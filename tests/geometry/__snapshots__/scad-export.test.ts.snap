exports[`Geometry Engine - OpenSCAD Generator > should generate valid OpenSCAD boolean subtractions for a given bitting 1`] = `
"
// Mimic Key Generator
// Profile: Golden Standard 5-Pin (Plugin: kwikset-kw1)
// Bitting: 02468

$fn = 64;

module kwikset_warding_profile() {
  polygon(points=[
    [0, 0], [2, 0], 
    [2, 3], [1.5, 3.5], [2, 4],
    [2, 8.6], 
    [0, 8.6], 
    [0, 6.5], [0.5, 6.0], [0, 5.5],
    [0, 4.5], [0.8, 4.0], [0, 3.5]
  ]);
}

module key_blank() {
  union() {
    translate([0, -25, 0])
    linear_extrude(height=2, center=true)
    polygon(points=[
      [-5, -5], [10, 0], [15, 12], [15, 25], [-15, 25], [-15, 12]
    ]);
    
    translate([0, 0, -1])
    rotate([90, 0, 90])
    linear_extrude(height=27.11)
    kwikset_warding_profile();
    
    translate([27.11, 0, 0])
    rotate([90, 0, 90])
    linear_extrude(height=4, scale=[0.2, 0.5])
    kwikset_warding_profile();
  }
}

module v_cut(depth) {
  hull() {
    translate([0, 0, depth])
    cube([0.5, 3, 0.1], center=true);
    
    translate([0, 0, depth + 10])
    cube([20, 3, 0.1], center=true);
  }
}

module cuts() {
  translate([6.27, 0, 7.35]) rotate([90, 0, 0]) v_cut(0);
  translate([10.23, 0, 6.1819999999999995]) rotate([90, 0, 0]) v_cut(0);
  translate([14.19, 0, 5.013999999999999]) rotate([90, 0, 0]) v_cut(0);
  translate([18.15, 0, 3.846]) rotate([90, 0, 0]) v_cut(0);
  translate([22.11, 0, 2.678]) rotate([90, 0, 0]) v_cut(0);
}

// Final Render
difference() {
  key_blank();
  cuts();
}
"
`;
